          "opacity": 0,
          "trackingAmount": 6,
          "blur": [
            30,
            30
          ]
        },
        "selector": {
          "basedOn": "words",
          "shape": "square"
        },
        "start": {
          "from": 0,
          "to": 100,
          "frames": 24,
          "framesRange": [
            12,
            48
          ],
          "outInfluence": 0.1,
          "inInfluence": 100
        }
      },
      "bounceWords": {
        "animator": {
          "position": [
            0,
            -50,
            0
          ],
          "opacity": 0,
          "blur": [
            10,
            10
          ]
        },
        "expressionSelector": "var amp = 14, freq = 3, decay = 6, delay = 0.05;\nvar charDelay = textIndex * delay;\nvar t = Math.max(0, time - thisLayer.inPoint - charDelay);\nvar bounce = Math.exp(-decay * t) * Math.cos(freq * 2 * Math.PI * t);\n100 * bounce;",
        "basedOn": "words"
      },
      "fadeHighlight": {
        "description": "Words fade in tinted accent blue + slight blur and settle to the dark text colour.",
        "fade": {
          "opacity": 0,
          "basedOn": "words",
          "smoothness": 0,
          "frames": 30,
          "outLinear": true,
          "inInfluence": 85
        },
        "tint": {
          "fillColor": "accentColor",
          "blur": [
            3,
            3
          ],
          "delayFrames": 3
        }
      },
      "charFade": {
        "animator": {
          "opacity": 0
        },
        "basedOn": "characters",
        "frames": 12,
        "outLinear": true,
        "inInfluence": 85
      }
    },
    "accentWords": "Key words (brand / product names) are set in accentColor.",
    "exit": {
      "frames": 8,
      "type": "opacity 100 -> 0, linear"
    },
    "revealStartsOnCut": true
  },
