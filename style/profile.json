  "cameraRig": {
    "description": "Control Null (drift) -> Camera_Controller <shot> (all keyframes live here) -> Camera <shot> (one-node, 50mm). The camera itself is never keyframed.",
    "controlNull": {
      "position": [
        960,
        540,
        0
      ],
      "drift": {
        "freq": 0.25,
        "ampX": 3,
        "ampY": 3,
        "ampZ": 0
      },
      "expression": "var freq = effect(\"TC - freq\")(\"Slider\");\nvar ampX = effect(\"TC - ampX\")(\"Slider\");\nvar ampY = effect(\"TC - ampY\")(\"Slider\");\nvar ampZ = effect(\"TC - ampZ\")(\"Slider\");\nvar xOffset = Math.sin(time * freq * Math.PI * 2) * ampX;\nvar yOffset = Math.cos(time * freq * Math.PI * 2) * ampY;\nvar zOffset = Math.sin(time * freq * 0.75 * Math.PI * 2) * ampZ;\nvalue + [xOffset, yOffset, zOffset];"
    },
    "camera": {
      "oneNode": true,
      "localPosition": [
        0,
        0,
        -2666.6667
      ],
      "zoom": 2666.6667,
      "focalMm": 50,
      "depthOfField": false
    },
    "overshootExpression": "var amp = 0.03, freq = 2.5, decay = 6;\nvar n = 0;\nif (numKeys > 0) { n = nearestKey(time).index; if (key(n).time > time) { n--; } }\nvar t = (n == 0) ? 0 : time - key(n).time;\nif (n > 0 && t < 1.5) {\n  var v = velocityAtTime(key(n).time - thisComp.frameDuration / 10);\n  value + v * amp * Math.sin(freq * 1.5 * t * 2 * Math.PI) / Math.exp(decay * 2.2 * t);\n} else { value; }",
    "overshootUsage": "optional, on a few controllers only"
  },
  "cameraMoves": {
    "eases": {
      "glide": {
        "frames": 30,
        "outInfluence": 70,
        "inInfluence": 70,
        "outLinear": false,
        "use": "default move"
      },
      "glideStrong": {
        "frames": 30,
        "outInfluence": 90,
        "inInfluence": 90,
        "outLinear": false,
        "use": "snappier move"
      },
      "punch": {
        "frames": 16,
        "outInfluence": 16.67,
        "inInfluence": 100,
        "outLinear": true,
        "use": "quick push-in / pull-out that lands softly"
      }
    },
    "typicalDistancePx": {
      "crane": 320,
      "dolly": 720,
      "dollyPunch": 360,
      "truck": 640
    },
    "moveMix": {
      "crane down": 25,
      "crane up": 20,
      "pull out": 20,
      "push in": 20,
      "truck": 15
    },
    "holdBetweenMovesFrames": {
      "min": 10,
      "typical": 36,
      "max": 90
    },
    "rotation": "cameras never rotate or zoom – all motion is translation"
  },
  "transitions": {
    "shotToShot": {
      "splitMoveCut": {
        "description": "Signature cut. Both shots' controllers carry the SAME 40-frame move (same direction & distance, same ease). The outgoing shot plays the first half, the cut happens exactly at the midpoint (peak speed), the incoming shot plays the second half. Text in the incoming shot starts its reveal on the cut.",
        "frames": 30,
        "cutAt": 0.5
      },
      "blurAssist": "Often combined with Camera Lens Blur 40 -> 0 on incoming elements (and 0 -> 40 on outgoing) over 15–20 frames."
    },
    "sceneToScene": {
      "whip": "Scene precomps butt together (0 overlap). The camera is mid-move at the join so motion carries across (same split-move idea across precomps).",
      "blurFade": "Alternative: outgoing elements blur 0->40 + fade, incoming elements blur 40->0 + fade over 15–20 frames."
    }
  },
